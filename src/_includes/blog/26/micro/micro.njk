<!DOCTYPE html>
<html lang="en">
<head>
	<title>{{ title }}</title>
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<link rel="icon" type="image/png" sizes="16x16" href="/media/favicons/16.png">
	<meta charset="UTF-8">
	<meta property="og:title" content="{{ title }}">
	<meta property="og:type" content="website">
	<meta property="og:url" content="https://wiggle.monster{{ permalink }}">
	<meta property="og:site_name" content="WiiCHiCKEN i AM AWESOME">
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="/more/archive/blog/26/micro.css" rel="stylesheet">
	<link href="https://fonts.googleapis.com/css2?family=Kode+Mono:wght@400..700&family=Ubuntu:ital,wght@0,300;0,400;0,500;0,700;1,300;1,400;1,500;1,700&display=swap" rel="stylesheet">
</head>
<body>
{% include "partials/navbar.njk" %}
<main>
	<nav class="side-panel toc-nav">
		{% if content | toc %}
			{{ content | toc | safe }}
		{% endif %}
	</nav>
	<article>
		<header>
			<h1>{{ title }}</h1>
		</header>
		{{ content | safe }}
	</article>
	<nav class="side-panel mb-nav">
		{% include "partials/blog/26/micro/micronav.njk" %}
	</nav>
</main>
</body>
</html>